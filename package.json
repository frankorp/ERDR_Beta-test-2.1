{
  "name": "erdr-system",
  "version": "2.4.1",
  "description": "Єдиний реєстр досудових розслідувань з постійною базою даних",
  "main": "index.html",
  "scripts": {
    "start": "php -S localhost:8000 server.php",
    "start-php": "php -S localhost:8000",
    "start-node": "node server.js",
    "dev": "concurrently \"npm run start-php\" \"live-server --port=3000\"",
    "test": "echo \"No tests specified\" && exit 0",
    "backup": "cp erdr_database.db backup/erdr_database_$(date +%Y%m%d_%H%M%S).db"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2"
  }
}
